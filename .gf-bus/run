#!/bin/sh
# Lanceur gf-bus (Linux, macOS, Git Bash sous Windows). Usage : .gf-bus/run <commande> — voir USAGE.md.
# Ne bloque jamais un agent : sans Node >= 22, sort en code 0 avec une ligne d'aide.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
node=${GF_BUS_NODE:-node}
if ! command -v "$node" >/dev/null 2>&1; then
  case "$1:$2" in
    hook:SessionStart|start:*|login:*|wrap:*|who:*|send:*) echo "gf-bus : Node.js >= 22 introuvable, bus des agents désactivé (installer Node puis relancer)." ;;
  esac
  [ "$1" = wrap ] && { shift 2>/dev/null; shift 2>/dev/null; }
  exit 0
fi
exec "$node" "$here/gf-bus.mjs" "$@"
