{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .gf-bus/run ] && sh .gf-bus/run hook SessionStart --tool codex || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .gf-bus/run ] && sh .gf-bus/run hook UserPromptSubmit --tool codex || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .gf-bus/run ] && sh .gf-bus/run hook SessionEnd --tool codex || true",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
