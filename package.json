{
  "name": "@gripforgeai/mcp",
  "version": "0.1.0",
  "description": "GripForge MCP server — attach weapons & props to rigged characters from Claude Code, Cursor or any MCP client. Calls the GripForge API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gripforge-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/server.js', 0o755)\"",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "3d",
    "gamedev",
    "rigging",
    "weapon",
    "bone-attach",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gripforgeai/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
