{
  "name": "@gripforgeai/mcp",
  "version": "0.1.9",
  "description": "The tools your AI needs to make your games. Turn prompts into production-ready game assets — rigged characters, attached weapons, seamless textures, terrain, VFX, HUDs — and playable game kits Unity, Godot, Unreal or Three.js can load.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gripforge-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/server.js', 0o755)\"",
    "prepare": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/server.js', 0o755)\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "3d",
    "gamedev",
    "rigging",
    "weapon",
    "bone-attach"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gripforgeai/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "mcpName": "io.github.gripforgeai/mcp"
}
