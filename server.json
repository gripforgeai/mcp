{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gripforgeai/mcp",
  "title": "GripForge",
  "description": "Turn prompts into production-ready game assets: animated characters, textures, terrain, VFX, HUD.",
  "websiteUrl": "https://gripforge.ai",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/gripforgeai/mcp/main/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/gripforgeai/mcp",
    "source": "github"
  },
  "version": "0.1.10",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://gripforge.ai/mcp",
      "headers": [
        {
          "name": "x-api-key",
          "description": "GripForge API key (gf_...) — create one at https://gripforge.ai/account",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "identifier": "@gripforgeai/mcp",
      "version": "0.1.10",
      "transport": {
        "type": "stdio"
      },
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "environmentVariables": [
        {
          "name": "GRIPFORGE_API_KEY",
          "description": "GripForge API key (gf_...) — create one at https://gripforge.ai/account",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
