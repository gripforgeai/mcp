{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" ] && sh \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" hook SessionStart || echo \"gf-bus : dossier .gf-bus absent, bus des agents désactivé.\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" ] && sh \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" hook UserPromptSubmit || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" ] && sh \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" hook PostToolUse || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" ] && sh \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" hook SessionEnd || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" ] && sh \"$CLAUDE_PROJECT_DIR/.gf-bus/run\" hook Stop || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
